# Postgres — two separate roles on purpose:
#   database_url            — low-privilege runtime role (app_user). Must
#                              NOT be a superuser or BYPASSRLS role, or the
#                              tenant-isolation RLS policies are silently
#                              skipped for every query.
#   migrations_database_url — owner/superuser role, used only by Alembic
#                              to create tables, roles, grants, and RLS
#                              policies. Never used by the running app.
DATABASE_URL=postgresql+psycopg://app_user:CHANGE_ME@localhost:5432/ai_workforce
MIGRATIONS_DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/ai_workforce

# Concurrency tuning — see app/db/session.py and app/main.py. Safe defaults
# for a single dev machine; raise DB_POOL_SIZE/MAX_OVERFLOW together with
# Postgres's own max_connections for a real deployment, and load-test
# before trusting any specific number under real concurrent call volume.
DB_POOL_SIZE=20
DB_POOL_MAX_OVERFLOW=20
BLOCKING_THREAD_POOL_SIZE=200

JWT_SECRET=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=720

# Hosted LLM (Anthropic Claude) for conversational replies + structured
# extraction (call summaries, QA scoring, intent routing). Get a key at
# https://console.anthropic.com — this is a real per-token cost.
# anthropic_effort defaults to "low": voice replies are short (max 3
# sentences) and latency-sensitive; raise it if replies feel shallow.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_EFFORT=low

# Speech-to-text (Deepgram, hosted). Get a key at
# https://console.deepgram.com — real per-minute cost, free trial credit
# available.
DEEPGRAM_API_KEY=

# Local/self-hosted embedding model via Ollama's OpenAI-compatible API
# (free, no key needed) — used ONLY for RAG document/query embeddings now;
# chat completions moved to Anthropic above. Install Ollama
# (https://ollama.com), then:
#   ollama pull nomic-embed-text
# LLM_MODEL/LLM_BASE_URL below are vestigial unless you roll chat back to
# a local model — safe to leave as-is.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:8b

# EMBEDDING_DIM must match the embedding model's native output size
# (nomic-embed-text = 768) — it's baked into the pgvector column, so
# changing models needs a new migration.
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# STT_LANGUAGE is still used (passed to Deepgram). The WHISPER_* settings
# below are unused now (STT moved to Deepgram) but left in place in case
# of a rollback to self-hosted faster-whisper.
STT_LANGUAGE=en
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Local text-to-speech (Piper, runs in-process, fully open-source/free).
# Download voice models once with, e.g.:
#   python -m piper.download_voices en_US-amy-medium
#   python -m piper.download_voices en_US-ryan-medium
#   python -m piper.download_voices en_GB-alan-medium
#   python -m piper.download_voices hi_IN-rohan-medium
# into PIPER_VOICES_DIR (each agent's `voice` field must match a
# downloaded voice name exactly).
PIPER_VOICES_DIR=./voices
PIPER_DEFAULT_VOICE=en_US-amy-medium

# Barge-in tuning — see app/telephony/vad.py. Defaults are a starting
# point; tune against real call audio quality once you have some.
BARGE_IN_MS=200
BARGE_IN_RMS_THRESHOLD=750

# Twilio — the one telephony piece; requires a signed BAA on your Twilio
# account for HIPAA scope.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
PUBLIC_SERVER_URL=

CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
