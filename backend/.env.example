# Postgres — two separate roles on purpose:
#   database_url            — low-privilege runtime role (app_user). Must
#                              NOT be a superuser or BYPASSRLS role, or the
#                              tenant-isolation RLS policies are silently
#                              skipped for every query.
#   migrations_database_url — owner/superuser role, used only by Alembic
#                              to create tables, roles, grants, and RLS
#                              policies. Never used by the running app.
DATABASE_URL=postgresql+psycopg://app_user:CHANGE_ME@localhost:5432/ai_workforce
MIGRATIONS_DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/ai_workforce

# Concurrency tuning — see app/db/session.py and app/main.py. Safe defaults
# for a single dev machine; raise DB_POOL_SIZE/MAX_OVERFLOW together with
# Postgres's own max_connections for a real deployment, and load-test
# before trusting any specific number under real concurrent call volume.
DB_POOL_SIZE=20
DB_POOL_MAX_OVERFLOW=20
BLOCKING_THREAD_POOL_SIZE=200

JWT_SECRET=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=720

# Hosted LLM (Azure OpenAI) for conversational replies + structured
# extraction (call summaries, QA scoring, intent routing). Create a
# resource + a chat-model deployment in Azure AI Studio, then fill these
# in — real per-token cost.
# AZURE_OPENAI_DEPLOYMENT is the *deployment name* you chose in Azure AI
# Studio, not a model name like "gpt-4o" — Azure routes by deployment.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# Azure AI Speech — one key + region covers both speech-to-text and
# text-to-speech (app/speech/stt.py, app/speech/tts.py). Get these from
# your Speech resource in the Azure Portal. Real per-minute cost.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# Used when an agent's `voice` field is empty or unrecognized. Full neural
# voice list: https://speech.microsoft.com/portal/voicegallery — set an
# agent's voice in Agent Studio to any name from that list.
AZURE_DEFAULT_VOICE=en-US-JennyNeural

# Local/self-hosted embedding model via Ollama's OpenAI-compatible API
# (free, no key needed) — used ONLY for RAG document/query embeddings;
# chat completions run through Azure OpenAI above, not this. Install
# Ollama (https://ollama.com), then:
#   ollama pull nomic-embed-text
# LLM_MODEL below is vestigial — kept only because rag/embeddings.py
# reuses this same client's base_url/api_key.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen3:8b

# EMBEDDING_DIM must match the embedding model's native output size
# (nomic-embed-text = 768) — it's baked into the pgvector column, so
# changing models needs a new migration.
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768

# STT_LANGUAGE is passed to Azure Speech (use its locale format, e.g.
# "en-US", not "en"). The WHISPER_*/PIPER_* settings below are unused now
# (both self-hosted speech pieces were replaced by Azure Speech above)
# but left in place in case of a rollback.
STT_LANGUAGE=en-US
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
PIPER_VOICES_DIR=./voices
PIPER_DEFAULT_VOICE=en_US-amy-medium

# Barge-in tuning — see app/telephony/vad.py. Defaults are a starting
# point; tune against real call audio quality once you have some.
BARGE_IN_MS=200
BARGE_IN_RMS_THRESHOLD=750

# Twilio — the one telephony piece; requires a signed BAA on your Twilio
# account for HIPAA scope.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
PUBLIC_SERVER_URL=

CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
